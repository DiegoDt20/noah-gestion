# URI PostgreSQL. Si usas Supabase, elige el pooler apropiado para tu entorno.
# No incluyas parámetros ssl, sslmode, sslcert, sslkey, sslrootcert, uselibpqcompat ni host en la URI.
DATABASE_URL=postgresql://postgres.xxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# true verifica certificado y nombre. false solo se permite en localhost fuera de producción.
DATABASE_SSL=true
# Opcional: certificado de la CA del proveedor en formato PEM (variable multilínea).
# DATABASE_CA_CERT=
# Cualquier texto largo y secreto (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto-de-32-caracteres

# IA: al activar, solo es obligatorio añadir la clave en el servidor y reiniciar.
# Modelo predeterminado incluido; cambiarlo es opcional. Diagnóstico: npm run check:ia
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# GitHub (opcional; solo en el servidor). Configura ambos para repos privados.
# GITHUB_READ_TOKEN=
# GITHUB_REPOSITORIES=organizacion/repositorio,otra-organizacion/otro-repositorio
