# Cadena de conexión de Supabase (Settings > Database > Connection string > URI, modo "Transaction pooler")
DATABASE_URL=postgresql://postgres.xxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# En una base local sin SSL usa false
DATABASE_SSL=true
# Cualquier texto largo y secreto (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto-de-32-caracteres
